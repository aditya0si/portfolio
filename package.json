{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "test": "node portfolio/test/concepts.test.js && node portfolio/test/evidence_reconciliation.test.js",
    "test:e2e": "playwright test",
